{
  "version": 1,
  "width": 260,
  "height": 101,
  "variables": {
    "title": {
      "type": "string"
    },
    "machine_placed": {
      "type": "string"
    },
    "machine_assembled": {
      "type": "string"
    },
    "example": {
      "type": "string"
    },
    "energy": {
      "type": "string"
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "duration": {
      "type": "string",
      "default": "literal:"
    }
  },
  "title": "$title",
  "elements": [
    {
      "id": "build",
      "type": "scene",
      "x": 2,
      "y": 2,
      "width": 150,
      "height": 146,
      "yaw": 225,
      "pitch": 25,
      "scale": 1.1,
      "blocks": [
        {
          "id": "machine",
          "pos": [
            0,
            0,
            0
          ],
          "state": "$machine_placed",
          "highlight": true
        },
        {
          "id": "core0",
          "pos": [
            1,
            0,
            0
          ],
          "state": "oritech:machine_core_1",
          "groups": [
            "cores"
          ]
        },
        {
          "id": "core1",
          "pos": [
            0,
            1,
            0
          ],
          "state": "oritech:machine_core_1",
          "groups": [
            "cores"
          ]
        },
        {
          "id": "core2",
          "pos": [
            1,
            1,
            0
          ],
          "state": "oritech:machine_core_1",
          "groups": [
            "cores"
          ]
        }
      ],
      "material_rules": [
        {
          "state": "oritech:machine_core_1",
          "label": "literal:Machine core (any tier)"
        }
      ],
      "steps": [
        {
          "id": "machine",
          "title": "literal:Machine",
          "text": "literal:Place the machine.",
          "include": [
            "machine"
          ]
        },
        {
          "id": "cores",
          "title": "literal:Cores",
          "text": "literal:Add three machine cores. Right-click the machine to see where they go.",
          "groups": [
            "cores"
          ]
        },
        {
          "id": "assemble",
          "title": "literal:Assemble",
          "text": "literal:Right-click the machine again and the cores fold into it.",
          "states": {
            "machine": "$machine_assembled",
            "core0": "oritech:machine_core_1[core_used=true]",
            "core1": "oritech:machine_core_1[core_used=true]",
            "core2": "oritech:machine_core_1[core_used=true]"
          },
          "markers": [
            {
              "icon": "right_click",
              "block": "machine",
              "text": "literal:Right-click the machine"
            }
          ]
        }
      ],
      "hero": true,
      "ratio": 0.83
    },
    {
      "type": "text",
      "x": 6,
      "y": 4,
      "width": 248,
      "text": "$example"
    },
    {
      "type": "group",
      "x": 8,
      "y": 15,
      "layout": "grid",
      "columns": 2,
      "cell_width": 20,
      "cell_height": 20,
      "elements": "$inputs"
    },
    {
      "type": "arrow",
      "x": 52,
      "y": 24,
      "x2": 74,
      "y2": 24
    },
    {
      "type": "group",
      "x": 80,
      "y": 15,
      "layout": "grid",
      "columns": 1,
      "cell_width": 20,
      "cell_height": 20,
      "elements": "$outputs"
    },
    {
      "type": "text",
      "x": 6,
      "y": 41,
      "width": 248,
      "text": "$duration",
      "color": "muted"
    },
    {
      "type": "text",
      "x": 6,
      "y": 52,
      "width": 248,
      "text": "$energy",
      "color": "muted"
    },
    {
      "id": "mats",
      "type": "materials",
      "scene": "build",
      "scope": "cumulative",
      "x": 6,
      "y": 63,
      "width": 100,
      "height": 32
    }
  ],
  "reflow": true,
  "auto_height": true,
  "hide_title": true
}
